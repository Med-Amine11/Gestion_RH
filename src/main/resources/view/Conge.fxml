<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="1100.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.grh.controller.CongeController">

   <children>
      <BorderPane prefHeight="600.0" prefWidth="1100.0">

         <!-- ================== TOP ================== -->
         <top>
            <AnchorPane prefHeight="45.0" styleClass="semi-top-form" stylesheets="@../css/style.css">
               <children>
                  <Label layoutX="14.0" layoutY="10.0" text="Gestion des Ressources Humaines - Congés">
                     <font><Font name="Tahoma" size="14.0"/></font>
                  </Label>
               </children>
            </AnchorPane>
         </top>

         <!-- ================== LEFT NAVIGATION ================== -->
         <left>
            <AnchorPane prefWidth="214.0" styleClass="nav-form" stylesheets="@../css/style.css">
               <children>
                  <ImageView layoutX="57.0" layoutY="30.0" fitWidth="100.0" fitHeight="100.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../images/image2.jpg"/></image>
                  </ImageView>

                  <Label layoutX="69.0" layoutY="140.0" text="Bienvenue," textFill="WHITE">
                     <font><Font name="Tahoma" size="17.0"/></font>
                  </Label>
                  <Label layoutX="9.0" layoutY="161.0" prefWidth="194.0" alignment="CENTER" text="Admin" textFill="WHITE">
                     <font><Font name="Arial Bold" size="20.0"/></font>
                  </Label>

                  <Line layoutX="-100" layoutY="198" startX="0" endX="121" stroke="WHITE"/>

                  <!-- Navigation Buttons -->
                  <Button fx:id="AccueilButton" layoutX="16.0" layoutY="227.0" prefWidth="180.0" prefHeight="35.0" styleClass="nav-btn" text="🏠 Accueil" onAction="#handleAccueil"/>
                  <Button fx:id="EmployesButton" layoutX="16.0" layoutY="262.0" prefWidth="180.0" prefHeight="35.0" styleClass="nav-btn" text="👤 Employés" onAction="#handleEmployes"/>
                  <Button fx:id="DepartementsButton" layoutX="16.0" layoutY="297.0" prefWidth="180.0" prefHeight="35.0" styleClass="nav-btn" text="🏢 Départements" onAction="#handleDepartement"/>
                  <Button fx:id="ContratsButton" layoutX="16.0" layoutY="332.0" prefWidth="180.0" prefHeight="35.0" styleClass="nav-btn" text="📄 Contrats" onAction="#handleContrats"/>
                  <Button fx:id="CongesButton" layoutX="16.0" layoutY="367.0" prefWidth="180.0" prefHeight="35.0" styleClass="nav-btn" text="🏖️ Congés" onAction="#handleConges"/>
                  <Button fx:id="ArchivesButton" layoutX="16.0" layoutY="402.0" prefWidth="180.0" prefHeight="35.0" styleClass="nav-btn" text="🗄️ Archives" onAction="#handleArchives"/>
                  <Button fx:id="logOutButton" layoutX="9.0" layoutY="509.0" prefWidth="180.0" prefHeight="35.0" styleClass="logout" text="Déconnexion" textFill="WHITE" onAction="#handleLogout"/>
               </children>
            </AnchorPane>
         </left>

         <!-- ================== CENTER ================== -->
         <center>
            <AnchorPane prefWidth="859.0" prefHeight="523.0" styleClass="white-bg shadow" stylesheets="@../css/style.css">

               <!-- Formulaire et boutons regroupés dans un VBox -->
               <VBox layoutX="10.0" layoutY="10.0" spacing="10">
                  <GridPane hgap="10" vgap="10">
                     <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                     <TextField fx:id="typeCongeField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="150.0"/>

                     <Label text="Motif:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                     <TextField fx:id="motifField" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="150.0"/>

                     <Label text="Début:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                     <DatePicker fx:id="dateDebutPicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                     <Label text="Fin:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                     <DatePicker fx:id="dateFinPicker" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                     <Label text="Employé:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                     <ComboBox fx:id="employeCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200.0" promptText="Sélectionnez un employé"/>
                  </GridPane>

                  <HBox spacing="10">
                     <Button fx:id="ajouterButton" text="Ajouter" onAction="#ajouterConge" prefWidth="100.0"/>
                     <Button fx:id="modifierButton" text="Modifier" onAction="#modifierConge" prefWidth="100.0"/>
                     <Button fx:id="validerButton" text="Valider" onAction="#validerConge" prefWidth="100.0" style="-fx-background-color: green; -fx-text-fill: white;"/>
                     <Button fx:id="refuserButton" text="Refuser" onAction="#refuserConge" prefWidth="100.0" style="-fx-background-color: red; -fx-text-fill: white;"/>
                     <TextField fx:id="searchNomField" promptText="Rechercher par nom" prefWidth="180.0"/>
                     <Button fx:id="rechercherButton" text="Rechercher" prefWidth="100.0"/>
                  </HBox>
               </VBox>

               <!-- TableView Congés -->
               <TableView fx:id="tableConges" AnchorPane.topAnchor="150" AnchorPane.leftAnchor="10"
                          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
                  <columns>
                     <TableColumn fx:id="colId" text="ID"/>
                     <TableColumn fx:id="colType" text="Type"/>
                     <TableColumn fx:id="colDateDebut" text="Début"/>
                     <TableColumn fx:id="colDateFin" text="Fin"/>
                     <TableColumn fx:id="colMotif" text="Motif"/>
                     <TableColumn fx:id="colIdEmploye" text="Employé"/>
                     <TableColumn fx:id="colStatut" text="Statut"/>
                  </columns>
               </TableView>

            </AnchorPane>
         </center>

      </BorderPane>
   </children>
</StackPane>
