<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0"
           prefWidth="1100.0"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.grh.controller.DepartementController"
           stylesheets="@../css/style.css">

   <children>

      <AnchorPane prefHeight="600.0" prefWidth="1100.0" styleClass="white-bg">

         <children>

            <AnchorPane layoutX="350.0"
                        layoutY="100.0"
                        prefHeight="400.0"
                        prefWidth="400.0"
                        styleClass="white-bg shadow">

               <children>

                  <Label layoutX="14.0" layoutY="14.0" text="Nouveau Département">
                     <font>
                        <Font size="20.0"/>
                     </font>
                  </Label>

                  <Label layoutX="30.0" layoutY="80.0" text="Nom:"/>
                  <TextField fx:id="addDepartementNom"
                             layoutX="30.0"
                             layoutY="100.0"
                             prefHeight="30.0"
                             prefWidth="340.0"
                             styleClass="textfield"/>

                  <Label layoutX="30.0" layoutY="150.0" text="Description:"/>
                  <TextArea fx:id="addDepartementDescription"
                            layoutX="30.0"
                            layoutY="170.0"
                            prefHeight="100.0"
                            prefWidth="340.0"
                            styleClass="textfield"/>

                  <Button layoutX="220.0"
                          layoutY="300.0"
                          prefHeight="40.0"
                          prefWidth="150.0"
                          onAction="#saveDepartement"
                          styleClass="add-btn"
                          text="Enregistrer"/>

                  <Button layoutX="30.0"
                          layoutY="300.0"
                          prefHeight="40.0"
                          prefWidth="150.0"
                          onAction="#handleDepartement"
                          styleClass="delete-btn"
                          text="Annuler"/>

               </children>
            </AnchorPane>

         </children>
      </AnchorPane>

   </children>
</StackPane>
