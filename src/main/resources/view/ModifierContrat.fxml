<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grh.controller.ModifierContratController">

    <children>
        <BorderPane prefHeight="600.0" prefWidth="1100.0">

            <!-- TOP -->
            <top>
                <AnchorPane prefHeight="45.0" styleClass="semi-top-form"
                    stylesheets="@../css/style.css">
                    <children>
                        <AnchorPane prefHeight="35.0" styleClass="top-form"
                            stylesheets="@../css/style.css" AnchorPane.leftAnchor="0"
                            AnchorPane.rightAnchor="0">
                            <children>
                                <Label layoutX="14" layoutY="10"
                                    text="Gestion des Ressources Humaines - Modifier Contrat">
                                    <font>
                                        <Font size="14" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>
            </top>

            <!-- LEFT MENU -->
            <left>
                <AnchorPane prefWidth="214.0" styleClass="nav-form" stylesheets="@../css/style.css">
                    <children>
                        <ImageView fitHeight="100" fitWidth="100" layoutX="57" layoutY="30">
                            <image>
                                <Image url="@../images/image2.jpg" />
                            </image>
                        </ImageView>

                        <Label layoutX="69" layoutY="140" text="Bienvenue," textFill="WHITE" />
                        <Label alignment="CENTER" layoutX="9" layoutY="161" prefWidth="194"
                            text="Admin" textFill="WHITE">
                            <font>
                                <Font size="20" />
                            </font>
                        </Label>

                        <Line endX="69" layoutX="121" layoutY="198" startX="-100" stroke="WHITE" />

                        <Button fx:id="AccueilButton" layoutX="16.0" layoutY="227.0"
                            mnemonicParsing="false" onAction="#handleAccueil" prefHeight="35.0"
                            prefWidth="180.0" styleClass="nav-btn" stylesheets="@../css/style.css"
                            text="🏠 Accueil" />
                        <Button fx:id="EmployesButton" layoutX="16.0" layoutY="262.0"
                            mnemonicParsing="false" onAction="#handleEmployes" prefHeight="35.0"
                            prefWidth="180.0" styleClass="nav-btn" stylesheets="@../css/style.css"
                            text="👤 Employés" />
                        <Button fx:id="DepartementsButton" layoutX="16.0" layoutY="297.0"
                            mnemonicParsing="false" onAction="#handleDepartement" prefHeight="35.0"
                            prefWidth="180.0" styleClass="nav-btn" stylesheets="@../css/style.css"
                            text="🏢 Départements" />
                        <Button fx:id="ContratsButton" layoutX="16.0" layoutY="332.0"
                            mnemonicParsing="false" onAction="#handleContrats" prefHeight="35.0"
                            prefWidth="180.0" styleClass="nav-btn" stylesheets="@../css/style.css"
                            text="📄 Contrats" />
                        <Button fx:id="CongesButton" layoutX="16.0" layoutY="367.0"
                            mnemonicParsing="false" onAction="#handleConges" prefHeight="35.0"
                            prefWidth="180.0" styleClass="nav-btn" stylesheets="@../css/style.css"
                            text="🏖️ Congés" />
                        <Button fx:id="ArchivesButton" layoutX="16.0" layoutY="402.0"
                            mnemonicParsing="false" onAction="#handleArchives" prefHeight="35.0"
                            prefWidth="180.0" styleClass="nav-btn" stylesheets="@../css/style.css"
                            text="🗄️ Archives" />

                        <Button fx:id="logOutButton" layoutX="9" layoutY="509"
                            onAction="#handleLogout" styleClass="logout" text="Déconnexion"
                            textFill="WHITE" />
                    </children>
                </AnchorPane>
            </left>

            <!-- CENTER FORM -->
            <center>
                <AnchorPane>
                    <AnchorPane layoutX="14.0" layoutY="18.0" prefHeight="523" prefWidth="859"
                        styleClass="white-bg shadow" stylesheets="@../css/style.css">

                        <children>
                            <Label layoutX="14" layoutY="14" text="Modifier Contrat">
                                <font>
                                    <Font size="18" />
                                </font>
                            </Label>

                            <!-- Fields -->
                            <Label layoutX="50" layoutY="70" text="Employé:" />
                            <ComboBox fx:id="cmbEmploye" layoutX="150" layoutY="65" prefWidth="250"
                                promptText="Sélectionner un employé..." styleClass="textfield" />

                            <Label layoutX="50" layoutY="120" text="Type de Contrat:" />
                            <ComboBox fx:id="cmbTypeContrat" layoutX="150" layoutY="115"
                                prefWidth="250" promptText="Sélectionner..." styleClass="textfield" />

                            <Label layoutX="50" layoutY="170" text="Salaire de Base:" />
                            <TextField fx:id="txtSalaireBase" layoutX="150" layoutY="165"
                                prefWidth="250" promptText="0.00" styleClass="textfield" />

                            <Label layoutX="50" layoutY="220" text="Date de Début:" />
                            <DatePicker fx:id="dpDateDebut" layoutX="150" layoutY="215"
                                prefWidth="250" styleClass="textfield" />

                            <Label layoutX="50" layoutY="270" text="Date de Fin:" />
                            <DatePicker fx:id="dpDateFin" layoutX="150" layoutY="265"
                                prefWidth="250" styleClass="textfield" />

                            <!-- Hidden ID field if needed, or stored in controller -->

                            <Label fx:id="lblErreurContrat" alignment="CENTER" layoutX="133.0"
                                layoutY="340.0" minHeight="20" prefHeight="29.0" prefWidth="650.0"
                                style="                                             -fx-text-fill: red;                                             -fx-font-size: 13px;                                             -fx-font-weight: bold;                                              "
                                visible="false" />


                            <!-- BUTTONS -->
                            <Button fx:id="btnEnregistrerContrat" layoutX="265.0" layoutY="348.0"
                                onAction="#modifierContrat" prefWidth="150"
                                style="-fx-translate-y: 20;" styleClass="update-btn" text="Modifier" />

                            <Button fx:id="btnAnnulerContrat" layoutX="525.0" layoutY="348.0"
                                onAction="#handleContrats" prefWidth="150"
                                style="-fx-translate-y: 20;" styleClass="clear-btn" text="Annuler" />

                        </children>
                    </AnchorPane>
                </AnchorPane>
            </center>

        </BorderPane>
    </children>
</StackPane>